{
    "version": "0.2.0",
    "configurations": [
        {
            // ----- Python (Debug) -----
            "name": "Python: Debug current file (external)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "externalTerminal"
        },
        {
            // ----- Python (Run only, no debugger) -----
            "name": "Python: Run current file (external)",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "externalTerminal",
            "noDebug": true
        },
        {
            // ----- C/C++ single-file debug with gdb -----
            "name": "C/C++: Build & Debug active file (external)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "C/C++: Build active file"
        },
        {
            // ----- C/C++ single-file run without debugger -----
            "name": "C/C++: Build & Run active file (external, no debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "C/C++: Build active file",
            "stopAtEntry": false,
            "noDebug": true
        },
        {
            // ----- CMake project debug with gdb -----
            "name": "CMake: Build & Debug target (external)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "CMake: build"
        },
        {
            // ----- Makefile project debug; set program if your binary differs -----
            "name": "Make: Build & Debug ./main (external)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/main",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Make: build"
        }
    ]
}
