def chunks(data: bytes) -> list[tuple[bytes, bytes]]:
    if data[:4] != b"RIFF" or data[8:12] != b"WEBP":
        raise ValueError("not a WebP RIFF container")
    result = []
    offset = 12
    while offset + 8 <= len(data):
        name = data[offset : offset + 4]
        size = struct.unpack_from("<I", data, offset + 4)[0]
        payload = data[offset + 8 : offset + 8 + size]
        if len(payload) != size:
            raise ValueError("truncated WebP chunk")
        result.append((name, payload))
        offset += 8 + size + (size & 1)
    if offset != len(data):
        raise ValueError("invalid WebP padding")
    return result


def dimensions(parts: list[tuple[bytes, bytes]]) -> tuple[int, int, bool]:
    for name, payload in parts:
        if name == b"VP8X":
            return 1 + int.from_bytes(payload[4:7], "little"), 1 + int.from_bytes(payload[7:10], "little"), bool(payload[0] & 0x10)
        if name == b"VP8L":
            bits = int.from_bytes(payload[1:5], "little")
            return 1 + (bits & 0x3FFF), 1 + ((bits >> 14) & 0x3FFF), bool((bits >> 28) & 1)
        if name == b"VP8 ":
            return struct.unpack_from("<H", payload, 6)[0] & 0x3FFF, struct.unpack_from("<H", payload, 8)[0] & 0x3FFF, False
    raise ValueError("WebP has no image payload")


def xmp(name: str, record: tuple[str, ...]) -> bytes:
    creator, licence, licence_url, source, commit, source_sha, processing, rights = record
    description = f"Source: {source}\nCommit: {commit}\nSource SHA-256: {source_sha}\nProcessing: {processing}"
    escape = lambda value: html.escape(value, quote=True)
    packet = f'''<?xpacket begin="\ufeff" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:xmpRights="http://ns.adobe.com/xap/1.0/rights/" xmlns:cc="http://creativecommons.org/ns#">
   <dc:title><rdf:Alt><rdf:li xml:lang="x-default">{escape(name)}</rdf:li></rdf:Alt></dc:title>
   <dc:creator><rdf:Seq><rdf:li>{escape(creator)}</rdf:li></rdf:Seq></dc:creator>
   <dc:source>{escape(source)}</dc:source>
   <dc:description><rdf:Alt><rdf:li xml:lang="x-default">{escape(description)}</rdf:li></rdf:Alt></dc:description>
   <dc:rights><rdf:Alt><rdf:li xml:lang="x-default">{escape(rights)}</rdf:li></rdf:Alt></dc:rights>
   <xmpRights:Marked>{str(licence not in ("CC0-1.0", "Unlicense")).lower()}</xmpRights:Marked>
   <xmpRights:UsageTerms><rdf:Alt><rdf:li xml:lang="x-default">{escape(licence)}</rdf:li></rdf:Alt></xmpRights:UsageTerms>
   <xmpRights:WebStatement>{escape(licence_url)}</xmpRights:WebStatement>
   <cc:license rdf:resource="{escape(licence_url)}"/>
  </rdf:Description>
 </rdf:RDF>
</x:xmpmeta>
<?xpacket end="w"?>'''
    return packet.encode("utf-8")


def pack(name: bytes, payload: bytes) -> bytes:
    return name + struct.pack("<I", len(payload)) + payload + (b"\0" if len(payload) & 1 else b"")


def embed(path: Path, metadata: bytes) -> None:
    parts = [(name, payload) for name, payload in chunks(path.read_bytes()) if name != b"XMP "]
    width, height, alpha = dimensions(parts)
    if parts[0][0] == b"VP8X":
        extended = bytearray(parts[0][1])
        extended[0] |= 0x04
        parts[0] = (b"VP8X", bytes(extended))
    else:
        flags = 0x04 | (0x10 if alpha else 0)
        extended = bytes([flags, 0, 0, 0]) + (width - 1).to_bytes(3, "little") + (height - 1).to_bytes(3, "little")
        parts.insert(0, (b"VP8X", extended))
    parts.append((b"XMP ", metadata))
    body = b"WEBP" + b"".join(pack(name, payload) for name, payload in parts)
    output = b"RIFF" + struct.pack("<I", len(body)) + body
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_bytes(output)
    temporary.replace(path)


def main() -> None:
    actual = {path.name for path in WALLPAPERS.glob("*.webp")}
    if actual != set(RECORDS):
        raise SystemExit(f"metadata records differ from wallpaper set: {sorted(actual ^ set(RECORDS))}")
    for name, record in RECORDS.items():
        embed(WALLPAPERS / name, xmp(name, record))


if __name__ == "__main__":
    main()
