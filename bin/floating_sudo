#!/usr/bin/env python3
"""Show and approve a sudo command in a floating Kitty window."""

from __future__ import annotations

import base64
import errno
import fcntl
import json
import os
from pathlib import Path
import shlex
import selectors
import signal
import shutil
import socket
import stat
import struct
import subprocess
import sys
import tempfile
import time
from typing import Any

KITTY = Path("/usr/bin/kitty")
SUDO = Path("/usr/bin/sudo")
NOTIFY_SEND = Path("/usr/bin/notify-send")
REJECTED = 125
EXEC_FAILED = 126
MISSING_TOOL = 127
INTERRUPTED = 130
REQUEST_BUSY = 75
RISKS = {"low", "medium", "high"}
EVENT_VERSION = 1
EVENT_NAMES = frozenset(
    {
        "awaiting_approval",
        "approved",
        "running",
        "stdout",
        "stderr",
        "finished",
    }
)
FRAME_HEADER = struct.Struct("!I")
MAX_FRAME_SIZE = 1024 * 1024
MAX_RELAY_CHUNK = 64 * 1024
# The relay forwards output in bounded chunks. It never retains command output.
RELAY_CONNECT_TIMEOUT = 5.0
RELAY_POLL_INTERVAL = 0.05
RELAY_DRAIN_TIMEOUT = 1.0
RELAY_SOCKET_NAME = "relay.sock"
OWNER_FILE_NAME = "owner.pid"
REQUEST_LOCK_NAME = "request.lock"
PACKAGE_LOCK_NAME = "floating-sudo-package.lock"
PACKAGE_MANAGERS = frozenset(
    {
        "apt",
        "apt-get",
        "aptitude",
        "dnf",
        "emerge",
        "flatpak",
        "nix",
        "pacman",
        "pamac",
        "paru",
        "pikaur",
        "rpm",
        "yay",
        "yum",
        "zypper",
    }
)
RESET = "\033[0m"
BOLD = "\033[1m"
CYAN = "\033[96m"
GREEN = "\033[92m"
YELLOW = "\033[93m"
RED = "\033[91m"
HELP = """\
usage: floating_sudo DESCRIPTION COMMAND [ARG ...]

Show a sudo command in a floating approval window, then run it only after
approval.

DESCRIPTION is one multiline argument with this format:

  sudo command
  command > what > why
  command > what > why
  Risk level: level > reasoning

The first line must exactly match Python's:

  shlex.join(["sudo", *arguments])

Use one description line per command or package. Each line must contain three
non-empty fields separated by `>`.
The risk level must be low, medium or high, followed by a non-empty reason.
Pass the command and its arguments after DESCRIPTION without a leading sudo.

The approval window shows the command, the description format and the risk as
highlighted sections. After approval, command stdout and stderr are relayed
live to the caller. Output is not written to request or result files.
The private relay sends versioned awaiting_approval, approved, running,
stdout, stderr and finished events. Output frames carry base64 bytes so they
keep their stream and encoding.

Examples:

  floating_sudo \\
    $'sudo pacman -S obs-studio jq\\nobs-studio > Install screen recording software > Record demos\\njq > Install a JSON processor > Inspect structured command output\\nRisk level: low > Both packages come from the configured package sources' \\
    pacman -S obs-studio jq

  floating_sudo \\
    $'sudo sed -i \\'s/^#Color/Color/\\' /etc/pacman.conf\\nsed -i > Enable coloured pacman output > Make package output easier to scan\\nRisk level: high > This edits an important system file in place' \\
    sed -i 's/^#Color/Color/' /etc/pacman.conf

Exit codes:

  0       approved command succeeded
  other   approved command status, passed through unchanged
  125     rejected, cancelled or invalid request
  126     command could not be executed
  127     required runtime tool is missing
  75      another package-manager request is already running
  130     caller interrupted the request
"""


class RequestError(ValueError):
    pass


class RelayError(ValueError):
    pass


class LockBusy(RuntimeError):
    pass


def fail(message: str, code: int = REJECTED) -> int:
    print(f"floating_sudo: {message}", file=sys.stderr)
    return code


def parse_request(description: str, command: list[str]) -> dict[str, Any]:
    lines = description.split("\n")
    if len(lines) < 3:
        raise RequestError("description must contain a command, details and risk")
    if not command:
        raise RequestError("command must not be empty")
    if command[0] == "sudo" or Path(command[0]).name == "sudo":
        raise RequestError("command arguments must omit sudo")

    displayed = lines[0]
    detail_lines = lines[1:-1]
    risk_line = lines[-1]
    if not detail_lines:
        raise RequestError("description must not be blank")
    for line in detail_lines:
        parts = line.split(">")
        if len(parts) != 3 or not all(part.strip() for part in parts):
            raise RequestError(
                "each description line must use: command > what > why"
            )

    prefix = "Risk level: "
    if not risk_line.startswith(prefix):
        raise RequestError("risk must use: Risk level: level > reasoning")
    risk_parts = risk_line[len(prefix) :].split(">", 1)
    if (
        len(risk_parts) != 2
        or risk_parts[0].strip() not in RISKS
        or not risk_parts[1].strip()
    ):
        raise RequestError(
            "risk must use low, medium or high followed by: > reasoning"
        )

    canonical = shlex.join(["sudo", *command])
    if displayed != canonical:
        raise RequestError(f"displayed command must be exactly: {canonical}")

    return {
        "command": command,
        "display": canonical,
        "description": "\n".join(detail_lines),
        "risk": risk_parts[0].strip(),
        "risk_reasoning": risk_parts[1].strip(),
    }


def valid_exit_code(value: object) -> bool:
    return (
        isinstance(value, int)
        and not isinstance(value, bool)
        and 0 <= value <= 255
    )


def make_event(name: str, **fields: Any) -> dict[str, Any]:
    if name not in EVENT_NAMES:
        raise RelayError(f"unknown relay event: {name}")
    event = {"version": EVENT_VERSION, "event": name}
    event.update(fields)
    return event


def output_event(stream: str, data: bytes) -> dict[str, Any]:
    if stream not in {"stdout", "stderr"}:
        raise RelayError(f"unknown output stream: {stream}")
    if not data or len(data) > MAX_RELAY_CHUNK:
        raise RelayError("relay output chunk is outside its size limit")
    return make_event(
        stream,
        data=base64.b64encode(data).decode("ascii"),
    )


def validate_event(event: object) -> dict[str, Any]:
    if not isinstance(event, dict):
        raise RelayError("relay event must be an object")
    if (
        not isinstance(event.get("version"), int)
        or isinstance(event.get("version"), bool)
        or event["version"] != EVENT_VERSION
    ):
        raise RelayError("unsupported relay event version")
    name = event.get("event")
    if not isinstance(name, str) or name not in EVENT_NAMES:
        raise RelayError("unknown relay event")

    if name in {"stdout", "stderr"}:
        encoded = event.get("data")
        if not isinstance(encoded, str):
            raise RelayError("relay output must contain base64 data")
        try:
            data = base64.b64decode(encoded, validate=True)
        except (ValueError, UnicodeError) as error:
            raise RelayError("relay output is not valid base64") from error
        if not data or len(data) > MAX_RELAY_CHUNK:
            raise RelayError("relay output chunk is outside its size limit")
    elif name == "finished":
        if event.get("outcome") not in {"completed", "rejected", "error"}:
            raise RelayError("invalid finished relay outcome")
        if not valid_exit_code(event.get("code")):
            raise RelayError("invalid finished relay code")

    return event


def encode_event(event: dict[str, Any]) -> bytes:
    validate_event(event)
    payload = json.dumps(
        event,
        ensure_ascii=False,
        separators=(",", ":"),
    ).encode("utf-8")
    if len(payload) > MAX_FRAME_SIZE:
        raise RelayError("relay event exceeds the frame size limit")
    return FRAME_HEADER.pack(len(payload)) + payload


class RelayReader:
    """Decode length-prefixed relay events across arbitrary socket reads."""

    def __init__(self) -> None:
        self.buffer = bytearray()

    def feed(self, data: bytes) -> list[dict[str, Any]]:
        if len(data) > MAX_FRAME_SIZE + FRAME_HEADER.size:
            raise RelayError("relay frame buffer exceeds the size limit")
        self.buffer.extend(data)
        events: list[dict[str, Any]] = []
        while len(self.buffer) >= FRAME_HEADER.size:
            (size,) = FRAME_HEADER.unpack(self.buffer[: FRAME_HEADER.size])
            if size > MAX_FRAME_SIZE:
                raise RelayError("relay frame exceeds the size limit")
            frame_size = FRAME_HEADER.size + size
            if len(self.buffer) < frame_size:
                break
            payload = bytes(self.buffer[FRAME_HEADER.size : frame_size])
            del self.buffer[:frame_size]
            try:
                event = json.loads(payload)
            except (json.JSONDecodeError, UnicodeDecodeError) as error:
                raise RelayError("relay frame is not valid JSON") from error
            events.append(validate_event(event))
        if len(self.buffer) > MAX_FRAME_SIZE + FRAME_HEADER.size:
            raise RelayError("relay frame buffer exceeds the size limit")
        return events


class RelaySender:
    """Send relay events and turn a disconnected caller into a soft failure."""

    def __init__(self, connection: socket.socket) -> None:
        self.connection = connection
        self.connected = True

    def send(self, event: dict[str, Any]) -> bool:
        if not self.connected:
            return False
        try:
            self.connection.sendall(encode_event(event))
        except (BrokenPipeError, ConnectionError, OSError):
            self.connected = False
            return False
        return True

    def close(self) -> None:
        self.connected = False
        self.connection.close()


def verify_private_directory(path: Path) -> None:
    try:
        info = path.lstat()
    except OSError as error:
        raise RelayError(f"could not inspect request directory: {error}") from error
    if not stat.S_ISDIR(info.st_mode):
        raise RelayError("request path is not a directory")
    if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) & 0o077:
        raise RelayError("request directory is not private")


def verify_private_socket(path: Path) -> None:
    try:
        info = path.lstat()
    except OSError as error:
        raise RelayError(f"could not inspect approval relay: {error}") from error
    if not stat.S_ISSOCK(info.st_mode):
        raise RelayError("approval relay is not a Unix socket")
    if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) & 0o077:
        raise RelayError("approval relay is not private")


def create_relay_server(path: Path) -> socket.socket:
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    bound = False
    try:
        server.bind(str(path))
        bound = True
        os.chmod(path, 0o600)
        verify_private_socket(path)
        server.listen(1)
        server.setblocking(False)
    except BaseException:
        server.close()
        if bound:
            path.unlink(missing_ok=True)
        raise
    return server


def connect_relay(request_path: Path) -> RelaySender:
    verify_private_directory(request_path.parent)
    relay_path = request_path.with_name(RELAY_SOCKET_NAME)
    verify_private_socket(relay_path)
    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        connection.settimeout(RELAY_CONNECT_TIMEOUT)
        connection.connect(str(relay_path))
        connection.settimeout(1.0)
    except BaseException:
        connection.close()
        raise
    return RelaySender(connection)


def write_private_text(path: Path, value: str) -> None:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="ascii") as output:
            fd = -1
            output.write(value)
            output.flush()
            os.fsync(output.fileno())
    except BaseException:
        if fd >= 0:
            os.close(fd)
        raise


def pid_is_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def cleanup_stale_requests(runtime: Path) -> None:
    try:
        candidates = runtime.glob("floating-sudo-*")
    except OSError:
        return
    for candidate in candidates:
        if candidate.is_symlink() or not candidate.is_dir():
            continue
        try:
            verify_private_directory(candidate)
            owner_path = candidate / OWNER_FILE_NAME
            owner_info = owner_path.lstat()
            if not stat.S_ISREG(owner_info.st_mode):
                continue
            if (
                owner_info.st_uid != os.getuid()
                or stat.S_IMODE(owner_info.st_mode) & 0o077
            ):
                continue
            pid = int(owner_path.read_text(encoding="ascii").strip())
        except (OSError, RelayError, ValueError):
            continue
        if not pid_is_alive(pid):
            shutil.rmtree(candidate, ignore_errors=True)


def acquire_lock(path: Path) -> int:
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    try:
        os.fchmod(fd, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError as error:
            if error.errno in {errno.EACCES, errno.EAGAIN}:
                raise LockBusy from error
            raise
    except BaseException:
        os.close(fd)
        raise
    return fd


def release_lock(fd: int | None) -> None:
    if fd is None:
        return
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)


def package_lock_path(runtime: Path, command: list[str]) -> Path | None:
    if command and Path(command[0]).name in PACKAGE_MANAGERS:
        return runtime / PACKAGE_LOCK_NAME
    return None


def atomic_json(path: Path, value: dict[str, Any]) -> None:
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            json.dump(value, output)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def read_json(path: Path) -> dict[str, Any]:
    with path.open(encoding="utf-8") as source:
        value = json.load(source)
    if not isinstance(value, dict):
        raise ValueError("expected an object")
    return value


def notify(message: str) -> None:
    if NOTIFY_SEND.is_file():
        subprocess.run(
            [str(NOTIFY_SEND), "floating_sudo", message],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )


def styled(colour: str, text: str, *, bold: bool = False) -> str:
    weight = BOLD if bold else ""
    return f"{weight}{colour}{text}{RESET}"


def validate_request(request: dict[str, Any]) -> list[str]:
    command = request.get("command")
    if (
        not isinstance(command, list)
        or not command
        or not all(isinstance(part, str) for part in command)
        or command[0] == "sudo"
        or Path(command[0]).name == "sudo"
    ):
        raise ValueError("invalid command")
    if request.get("display") != shlex.join(["sudo", *command]):
        raise ValueError("invalid displayed command")

    description = request.get("description")
    if not isinstance(description, str) or not description:
        raise ValueError("invalid description")
    for line in description.split("\n"):
        parts = line.split(">")
        if len(parts) != 3 or not all(part.strip() for part in parts):
            raise ValueError("invalid description format")

    if request.get("risk") not in RISKS:
        raise ValueError("invalid risk")
    if (
        not isinstance(request.get("risk_reasoning"), str)
        or not request["risk_reasoning"].strip()
    ):
        raise ValueError("invalid risk reasoning")
    return command


def normalise_return_code(value: object) -> int | None:
    if not isinstance(value, int) or isinstance(value, bool):
        return None
    if value < 0:
        value = 128 + abs(value)
    return value if 0 <= value <= 255 else None


def write_bytes(stream: Any, data: bytes) -> bool:
    """Write bytes to a terminal or test stream without decoding real output."""

    try:
        stream.flush()
    except (AttributeError, OSError, ValueError):
        pass
    try:
        fd = stream.fileno()
    except (AttributeError, OSError, ValueError):
        fd = None

    if fd is not None:
        offset = 0
        try:
            while offset < len(data):
                written = os.write(fd, data[offset:])
                if written == 0:
                    return False
                offset += written
            return True
        except (BrokenPipeError, OSError):
            return False

    buffer = getattr(stream, "buffer", None)
    try:
        if buffer is not None:
            buffer.write(data)
            buffer.flush()
        else:
            try:
                stream.write(data.decode("utf-8", errors="replace"))
            except TypeError:
                stream.write(data)
            stream.flush()
    except (BrokenPipeError, OSError, TypeError, UnicodeError):
        return False
    return True


def write_output(stream_name: str, data: bytes) -> bool:
    stream = sys.stdout if stream_name == "stdout" else sys.stderr
    return write_bytes(stream, data)


def finish_result(
    result_path: Path,
    relay: RelaySender | None,
    outcome: str,
    code: int,
) -> None:
    atomic_json(result_path, {"outcome": outcome, "code": code})
    if relay is not None:
        relay.send(make_event("finished", outcome=outcome, code=code))


def run_privileged(command: list[str], relay: RelaySender) -> int:
    process = subprocess.Popen(
        [str(SUDO), "--", *command],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        bufsize=0,
    )
    selector = selectors.DefaultSelector()
    pipes: dict[Any, str] = {}
    for stream_name, pipe in (("stdout", process.stdout), ("stderr", process.stderr)):
        if pipe is None:
            continue
        os.set_blocking(pipe.fileno(), False)
        selector.register(pipe, selectors.EVENT_READ, stream_name)
        pipes[pipe] = stream_name

    try:
        while pipes:
            for key, _ in selector.select(RELAY_POLL_INTERVAL):
                pipe = key.fileobj
                stream_name = key.data
                try:
                    data = os.read(pipe.fileno(), MAX_RELAY_CHUNK)
                except BlockingIOError:
                    continue
                if not data:
                    selector.unregister(pipe)
                    pipes.pop(pipe, None)
                    pipe.close()
                    continue
                write_output(stream_name, data)
                relay.send(output_event(stream_name, data))
    except KeyboardInterrupt:
        if process.poll() is None:
            process.send_signal(signal.SIGINT)
    finally:
        selector.close()
        for pipe in pipes:
            pipe.close()

    return_code = process.wait()
    code = normalise_return_code(return_code)
    return code if code is not None else EXEC_FAILED


def render_request(request: dict[str, Any]) -> None:
    risk_colours = {"low": GREEN, "medium": YELLOW, "high": RED}
    print(styled(CYAN, "Command", bold=True), flush=True)
    print(styled(CYAN, request["display"], bold=True), flush=True)
    print()
    print(styled(CYAN, "Description", bold=True), flush=True)
    print(styled(CYAN, "command > what > why", bold=True), flush=True)
    print(request["description"], flush=True)
    print()
    print(styled(CYAN, "Risk", bold=True), flush=True)
    print(
        styled(
            risk_colours[request["risk"]],
            f"{request['risk'].upper()} > {request['risk_reasoning']}",
            bold=True,
        ),
        flush=True,
    )


def child(request_path: Path) -> int:
    result_path = request_path.with_name("result.json")
    try:
        verify_private_directory(request_path.parent)
        request = read_json(request_path)
        command = validate_request(request)
        write_private_text(
            request_path.parent / OWNER_FILE_NAME, f"{os.getpid()}\n"
        )
    except (OSError, RelayError, ValueError, KeyError, json.JSONDecodeError) as error:
        try:
            finish_result(result_path, None, "error", REJECTED)
        except OSError:
            pass
        return fail(f"could not read request: {error}")

    try:
        relay = connect_relay(request_path)
    except (OSError, RelayError) as error:
        try:
            finish_result(result_path, None, "error", REJECTED)
        except OSError:
            pass
        return fail(f"approval relay is unavailable: {error}")

    try:
        if not relay.send(make_event("awaiting_approval")):
            finish_result(result_path, None, "error", REJECTED)
            return fail("approval relay disconnected before approval")

        render_request(request)
        try:
            response = input(f"\n{BOLD}Approve?{RESET} [y/N] ")
            approved = response.strip().casefold() == "y"
        except EOFError:
            approved = False
        except KeyboardInterrupt:
            finish_result(result_path, relay, "error", INTERRUPTED)
            return fail("request interrupted", INTERRUPTED)

        if not approved:
            finish_result(result_path, relay, "rejected", REJECTED)
            print(f"{BOLD}\nRejected. Nothing was run.{RESET}", flush=True)
            notify("Request rejected")
            return REJECTED

        # This event is sent before the command starts so the caller can act on
        # approval even when the command produces no output.
        if not relay.send(make_event("approved")):
            finish_result(result_path, None, "error", REJECTED)
            return fail("approval relay disconnected after approval")
        print(f"{BOLD}\nApproved. Running sudo now.{RESET}", flush=True)
        if not relay.send(make_event("running")):
            finish_result(result_path, None, "error", REJECTED)
            return fail("approval relay disconnected before the command started")

        try:
            code = run_privileged(command, relay)
        except OSError as error:
            finish_result(result_path, relay, "error", EXEC_FAILED)
            return fail(f"could not run sudo: {error}", EXEC_FAILED)
        finish_result(result_path, relay, "completed", code)
        print(f"{BOLD}\nCommand finished with exit code {code}.{RESET}", flush=True)
        notify(f"Command finished with exit code {code}")
        return code
    finally:
        relay.close()


def close_process_before_start(process: Any) -> None:
    try:
        if process.poll() is None:
            process.terminate()
    except (OSError, AttributeError):
        return
    try:
        process.wait(timeout=1)
    except subprocess.TimeoutExpired:
        try:
            process.kill()
            process.wait()
        except OSError:
            pass


def handle_relay_event(
    event: dict[str, Any],
    state: dict[str, bool],
    output_enabled: dict[str, bool],
) -> tuple[int | None, bool]:
    name = event["event"]
    if name == "approved":
        state["approved"] = True
        write_output(
            "stderr",
            f"{styled(GREEN, 'Approved. Running sudo now.', bold=True)}\n".encode(),
        )
    elif name == "running":
        state["started"] = True
    elif name in {"stdout", "stderr"}:
        if output_enabled[name]:
            try:
                data = base64.b64decode(event["data"], validate=True)
            except (ValueError, UnicodeError):
                raise RelayError("relay output is not valid base64") from None
            output_enabled[name] = write_output(name, data)
    elif name == "finished":
        return event["code"], True
    return None, False


def relay_parent(
    server: socket.socket,
    process: Any,
    result_path: Path,
    state: dict[str, bool],
) -> int:
    selector = selectors.DefaultSelector()
    selector.register(server, selectors.EVENT_READ, "listener")
    client: socket.socket | None = None
    reader = RelayReader()
    output_enabled = {"stdout": True, "stderr": True}
    finished_code: int | None = None
    finished_received = False
    finished_deadline: float | None = None
    relay_lost = False
    relay_lost_before_start = False
    connection_deadline = time.monotonic() + RELAY_CONNECT_TIMEOUT
    process_done_deadline: float | None = None

    def disconnect_client() -> None:
        nonlocal client
        if client is None:
            return
        try:
            selector.unregister(client)
        except (KeyError, ValueError):
            pass
        client.close()
        client = None

    try:
        while True:
            raw_process_code = process.poll()
            process_code = normalise_return_code(raw_process_code)
            process_done = raw_process_code is not None and process_code is not None
            now = time.monotonic()
            if process_done and process_done_deadline is None:
                process_done_deadline = now + RELAY_DRAIN_TIMEOUT
            if client is None:
                if process_done and now >= process_done_deadline:
                    break
                if not process_done and now >= connection_deadline:
                    close_process_before_start(process)
                    break

            ready = selector.select(RELAY_POLL_INTERVAL)
            if not ready:
                if finished_received and finished_deadline is None:
                    finished_deadline = time.monotonic() + RELAY_DRAIN_TIMEOUT
                if process_done and client is not None and (
                    finished_received or result_path.is_file()
                ):
                    break
                if (
                    process_done
                    and client is None
                    and process_done_deadline is not None
                    and time.monotonic() >= process_done_deadline
                ):
                    break
                if finished_deadline is not None and time.monotonic() >= finished_deadline:
                    break
                continue

            for key, _ in ready:
                if key.data == "listener":
                    try:
                        connection, _ = server.accept()
                    except BlockingIOError:
                        continue
                    connection.setblocking(False)
                    if client is None:
                        client = connection
                        selector.unregister(server)
                        selector.register(client, selectors.EVENT_READ, "client")
                    else:
                        connection.close()
                    continue

                if client is None:
                    continue
                try:
                    data = client.recv(MAX_FRAME_SIZE + FRAME_HEADER.size)
                except BlockingIOError:
                    continue
                except OSError:
                    data = b""
                if not data:
                    disconnect_client()
                    relay_lost = True
                    if not state["started"]:
                        relay_lost_before_start = True
                        close_process_before_start(process)
                    break
                try:
                    events = reader.feed(data)
                    for event in events:
                        event_code, is_finished = handle_relay_event(
                            event, state, output_enabled
                        )
                        if is_finished:
                            finished_code = event_code
                            finished_received = True
                            finished_deadline = (
                                time.monotonic() + RELAY_DRAIN_TIMEOUT
                            )
                except RelayError:
                    disconnect_client()
                    relay_lost = True
                    if not state["started"]:
                        relay_lost_before_start = True
                        close_process_before_start(process)
                    break

            if not state["started"] and client is None:
                break
            if relay_lost and state["started"]:
                process.wait()
                break
            if finished_received and result_path.is_file():
                break
            if finished_deadline is not None and time.monotonic() >= finished_deadline:
                break
    finally:
        disconnect_client()
        selector.close()

    if process.poll() is None and (finished_received or relay_lost):
        process.wait()

    if relay_lost_before_start:
        return REJECTED

    result: dict[str, Any] | None = None
    if result_path.is_file():
        try:
            result = read_json(result_path)
        except (OSError, ValueError, json.JSONDecodeError) as error:
            return fail(f"child returned an invalid result: {error}", EXEC_FAILED)
        code = result.get("code")
        if valid_exit_code(code):
            return code
        return fail("child returned an invalid result", EXEC_FAILED)
    if valid_exit_code(finished_code):
        return finished_code
    process_code = normalise_return_code(process.poll())
    if process_code is not None and process_code != 0:
        return process_code
    return fail("request was cancelled")


def parent(description: str, command: list[str]) -> int:
    try:
        request = parse_request(description, command)
    except RequestError as error:
        return fail(str(error))

    if not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
        return fail("no graphical session is available")
    for path in (KITTY, SUDO):
        if not path.is_file():
            return fail(f"required tool is missing: {path}", MISSING_TOOL)

    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime or not Path(runtime).is_dir():
        return fail("XDG_RUNTIME_DIR is not available")

    runtime_path = Path(runtime)
    try:
        verify_private_directory(runtime_path)
    except RelayError as error:
        return fail(f"XDG_RUNTIME_DIR is not private: {error}")
    cleanup_stale_requests(runtime_path)
    request_dir: Path | None = None
    request_lock: int | None = None
    package_lock: int | None = None
    process: subprocess.Popen[bytes] | None = None
    relay_server: socket.socket | None = None
    state = {"approved": False, "started": False}
    try:
        package_path = package_lock_path(runtime_path, command)
        if package_path is not None:
            try:
                package_lock = acquire_lock(package_path)
            except LockBusy:
                return fail(
                    "another package-manager request is already running",
                    REQUEST_BUSY,
                )

        request_dir = Path(tempfile.mkdtemp(prefix="floating-sudo-", dir=runtime))
        os.chmod(request_dir, 0o700)
        verify_private_directory(request_dir)
        request_lock = acquire_lock(request_dir / REQUEST_LOCK_NAME)
        write_private_text(request_dir / OWNER_FILE_NAME, f"{os.getpid()}\n")
        request_path = request_dir / "request.json"
        result_path = request_dir / "result.json"
        relay_path = request_dir / RELAY_SOCKET_NAME
        atomic_json(request_path, request)
        relay_server = create_relay_server(relay_path)
        process = subprocess.Popen(
            [
                str(KITTY),
                "--class",
                "floating-sudo",
                "--override",
                "background_opacity=0.3",
                "--title",
                "Approve privileged command",
                str(Path(__file__).resolve()),
                "--child",
                str(request_path),
            ],
            start_new_session=True,
        )
        return relay_parent(relay_server, process, result_path, state)
    except KeyboardInterrupt:
        if process is not None and not state["started"]:
            close_process_before_start(process)
        elif process is not None:
            try:
                process.wait()
            except (OSError, KeyboardInterrupt):
                pass
            if request_dir is not None:
                result_path = request_dir / "result.json"
                if result_path.is_file():
                    try:
                        result = read_json(result_path)
                        code = result.get("code")
                        if valid_exit_code(code):
                            return code
                    except (OSError, ValueError, json.JSONDecodeError):
                        pass
        return fail("request interrupted", INTERRUPTED)
    except LockBusy:
        return fail("could not create the private request lock", EXEC_FAILED)
    except FileNotFoundError as error:
        return fail(f"required tool is missing: {error.filename}", MISSING_TOOL)
    except (OSError, RelayError, ValueError, json.JSONDecodeError) as error:
        if process is not None and not state["started"]:
            close_process_before_start(process)
        elif process is not None:
            try:
                process.wait()
            except (OSError, KeyboardInterrupt):
                pass
        return fail(f"request failed: {error}", EXEC_FAILED)
    finally:
        if relay_server is not None:
            relay_server.close()
        if request_dir is not None:
            (request_dir / RELAY_SOCKET_NAME).unlink(missing_ok=True)
            shutil.rmtree(request_dir, ignore_errors=True)
        release_lock(request_lock)
        release_lock(package_lock)


def main(argv: list[str]) -> int:
    if len(argv) == 2 and argv[1] in {"-h", "--help"}:
        print(HELP, end="")
        return 0
    if len(argv) == 3 and argv[1] == "--child":
        return child(Path(argv[2]))
    if len(argv) < 3:
        return fail("usage: floating_sudo DESCRIPTION COMMAND [ARG ...]")
    return parent(argv[1], argv[2:])


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
