#!/usr/bin/env bash

set -u

threshold="${LOW_POWER_THRESHOLD:-30}"
state_dir="${XDG_RUNTIME_DIR:-$HOME/.cache}"
state_file="$state_dir/battery-low-power-active"
script_root="${QUICKSHELL_SCRIPT_ROOT:-$HOME/.config/quickshell/blox/scripts}"

find_battery_dir() {
    local battery_dir

    for battery_dir in /sys/class/power_supply/BAT*; do
        if [[ -r "$battery_dir/capacity" && -r "$battery_dir/status" ]]; then
            printf '%s\n' "$battery_dir"
            return 0
        fi
    done

    return 1
}

run_low_power_mode() {
    local capacity="$1"
    local failed_actions=()

    if ! "$script_root/osd/control.sh" brightness-set 0; then
        failed_actions+=(brightness)
    fi

    if ! "$script_root/gpu/modes/igpu60.sh" --quiet; then
        failed_actions+=(gpu)
    fi

    if ! rfkill block bluetooth; then
        failed_actions+=(bluetooth)
    fi

    if (( ${#failed_actions[@]} == 0 )); then
        notify-send -i battery-low "Low Power Mode Active" "Battery at ${capacity}%. Brightness minimized, iGPU 60 Hz mode enabled, and Bluetooth disabled."
    else
        logger -t battery-low-power "Low-power mode was only partially applied; failed actions: ${failed_actions[*]}. It will not be reapplied until the battery recovers or starts charging."
    fi
}

main() {
    local battery_dir capacity status

    if ! battery_dir="$(find_battery_dir)"; then
        exit 0
    fi

    read -r capacity < "$battery_dir/capacity"
    read -r status < "$battery_dir/status"
    status="$(printf '%s' "$status" | tr '[:upper:]' '[:lower:]')"

    if [[ "$status" != "discharging" ]]; then
        rm -f "$state_file"
        exit 0
    fi

    if (( capacity > threshold )); then
        rm -f "$state_file"
        exit 0
    fi

    if [[ -f "$state_file" ]]; then
        exit 0
    fi

    # Record the threshold crossing before applying anything. This makes the
    # operation edge-triggered even when one action fails, so later timer runs
    # do not override manual brightness, GPU, or Bluetooth changes.
    mkdir -p "$state_dir"
    printf '%s\n' "$capacity" > "$state_file"
    run_low_power_mode "$capacity"
}

main "$@"
