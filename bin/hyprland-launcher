#!/bin/bash

# Check if we booted with modeset=1 (HDMI mode)
if grep -q "nvidia-drm.modeset=1" /proc/cmdline; then
    # HDMI Mode - Use NVIDIA as primary
    export AQ_DRM_DEVICES=/dev/dri/card0:/dev/dri/card1
    export LIBVA_DRIVER_NAME=nvidia
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
    export GBM_BACKEND=nvidia-drm
    export WLR_NO_HARDWARE_CURSORS=1
    
    # Create temporary HDMI override
    cat > /tmp/hyprland-hdmi-env <<'ENVEOF'
# HDMI Mode - NVIDIA primary
env = AQ_DRM_DEVICES,/dev/dri/card0:/dev/dri/card1
env = LIBVA_DRIVER_NAME,nvidia
env = __GLX_VENDOR_LIBRARY_NAME,nvidia
env = GBM_BACKEND,nvidia-drm
env = WLR_NO_HARDWARE_CURSORS,1

monitor = HDMI-A-1,preferred,1920x0,2
ENVEOF
    
    logger "Hyprland Launcher: HDMI mode - NVIDIA primary (card0:card1)"
else
    # Battery Mode - Create empty override
    cat > /tmp/hyprland-hdmi-env <<'ENVEOF'
# Battery mode - no overrides
ENVEOF
    
    logger "Hyprland Launcher: Battery mode"
fi

# Start Hyprland
exec start-hyprland "$@"
