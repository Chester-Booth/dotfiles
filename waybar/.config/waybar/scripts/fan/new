#!/usr/bin/env bash
# ALTERNATIVE GPU DETECTION: Uses simpler method (checks if nvidia-smi responds)

# Get active asusctl profile
profile=$(asusctl profile get | awk -F': ' '{print $2}')

# === FAN SPEED ===
fan1=$(cat /sys/class/hwmon/hwmon*/fan1_input 2>/dev/null | head -1)
fan2=$(cat /sys/class/hwmon/hwmon*/fan2_input 2>/dev/null | head -1)

if [ -n "$fan1" ] && [ -n "$fan2" ] && [ "$fan2" != "0" ]; then
    fan_rpm="$fan1 / $fan2"
elif [ -n "$fan1" ]; then
    fan_rpm="$fan1"
else
    fan_rpm="N/A"
fi

# === CPU TEMPERATURE ===
cpu_temp=""
for hwmon in /sys/class/hwmon/hwmon*/temp1_input; do
    [ -f "$hwmon" ] || continue
    name=$(cat "$(dirname "$hwmon")/name" 2>/dev/null)
    if [[ "$name" =~ ^(k10temp|coretemp|zenpower)$ ]]; then
        temp=$(cat "$hwmon")
        cpu_temp=$((temp / 1000))
        break
    fi
done
[ -z "$cpu_temp" ] && cpu_temp="N/A"

# === CPU CLOCK ===
total=0
count=0
for freq in /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq; do
    [ -f "$freq" ] || continue
    total=$((total + $(cat "$freq")))
    ((count++))
done
[ $count -gt 0 ] && cpu_clock=$(awk "BEGIN {printf \"%.2f\", $total/$count/1000000}") || cpu_clock="N/A"

# === CPU UTILIZATION ===
read cpu user nice sys idle iowait irq softirq steal guest guest_nice < <(head -1 /proc/stat)
total=$((user + nice + sys + idle + iowait + irq + softirq + steal))
idle=$((idle + iowait))

cache="/tmp/waybar_cpu_fan_module"
if [ -f "$cache" ]; then
    read prev_total prev_idle < "$cache"
    diff_total=$((total - prev_total))
    diff_idle=$((idle - prev_idle))
    [ $diff_total -gt 0 ] && cpu_util=$(( (diff_total - diff_idle) * 100 / diff_total )) || cpu_util=0
else
    cpu_util=0
fi
echo "$total $idle" > "$cache"

# === POWER DRAW ===
power_uw=$(cat /sys/class/power_supply/BAT*/power_now 2>/dev/null | head -1)
[ -n "$power_uw" ] && power=$(awk "BEGIN {printf \"%.1f\", $power_uw/1000000}") || power="N/A"

# === RAM USAGE ===
read mem_total mem_avail < <(awk '/MemTotal:|MemAvailable:/ {print $2}' /proc/meminfo | xargs)
ram_used=$(awk "BEGIN {printf \"%.1f\", ($mem_total-$mem_avail)/1048576}")
ram_total=$(awk "BEGIN {printf \"%.1f\", $mem_total/1048576}")

# === dGPU INFO (SIMPLER METHOD - just check if nvidia-smi responds) ===
gpu_info=""
if timeout 0.5 nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits &>/dev/null; then
    # GPU responded, assume it's active and get stats
    gpu_util=$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null || echo "0")
    gpu_temp=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader 2>/dev/null || echo "N/A")
    vram_used=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null || echo "0")
    vram_total=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits 2>/dev/null || echo "0")
    
    # Convert VRAM from MiB to GB
    vram_used_gb=$(awk "BEGIN {printf \"%.1f\", $vram_used/1024}")
    vram_total_gb=$(awk "BEGIN {printf \"%.1f\", $vram_total/1024}")
    
    # Build GPU lines
    gpu_info="
󰢮 ${gpu_util}% at ${gpu_temp}°C
  ${vram_used_gb}/${vram_total_gb} GB VRAM"
fi

# === BUILD TOOLTIP ===
tooltip="󱐋 ${profile}
󰈐 ${fan_rpm} RPM
󰘚 ${cpu_util}% at ${cpu_clock} GHz 
󰔏 ${cpu_temp}°C${gpu_info}
󱟤 ${power} W   
 ${ram_used}/${ram_total} GB"

# Output JSON
jq -nc --arg txt "$profile" --arg tooltip "$tooltip" \
    '{text: $txt, alt: $txt, tooltip: $tooltip, class: $txt}'
