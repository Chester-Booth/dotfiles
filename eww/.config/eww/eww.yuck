;; Get current filenames for editor
(defpoll todo_current_file
  :interval "1s"
  :initial ""
  "cat /tmp/eww-todo-current 2>/dev/null || echo ~/Documents/todo/1-todo.md")

(defpoll gcal_current_file
  :interval "1s"
  :initial ""
  "cat /tmp/eww-gcal-current 2>/dev/null || echo ~/Documents/todo/2-gcal.md")

;; Variables that poll file content
(defpoll todo_content
  :interval "1s"
  :initial "Loading..."
  "~/.config/eww/scripts/todo-content.sh")

(defpoll gcal_content
  :interval "1s"
  :initial "Loading..."
  "~/.config/eww/scripts/gcal-content.sh")

;; Todo overlay window
(defwindow todo-overlay
  :monitor 0
  :geometry (geometry 
    :x "20px"
    :y "20px"
    :anchor "top left")
  :stacking "bg"
  :exclusive false
  :focusable false
  :namespace "todo-overlay"
  (eventbox
    :onclick "~/.config/eww/scripts/cycle-todo.sh > /dev/null"
    :onrightclick "hyprctl dispatch exec \"~/.config/eww/scripts/open-todo-editor.sh\""
    :cursor "pointer"
    (box 
        :class "overlay-box"
        :orientation "v"
        (label 
          :text todo_content
          :xalign 0
          :yalign 0
          :wrap false
          :show-truncated false))))

;; Calendar overlay window
(defwindow gcal-overlay
  :monitor 0
  :geometry (geometry 
    :x "20px"
    :y "20px"
    :anchor "bottom right")
  :stacking "bg"
  :exclusive false
  :focusable false
  (eventbox
    :onclick "~/.config/eww/scripts/cycle-gcal.sh > /dev/null"
    :onrightclick "~/.config/eww/scripts/right-click-gcal.sh > /dev/null"
    :cursor "pointer"
    (box 
        :class "overlay-box"
        :orientation "v"
        (label 
          :text gcal_content
          :xalign 0
          :yalign 0
          :wrap false
          :show-truncated false))))
