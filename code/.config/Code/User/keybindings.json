// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+shift+e",
        "command": "workbench.view.explorer",
        "when": "viewContainer.workbench.view.explorer.enabled"
    },
    {
        "key": "ctrl+shift+e",
        "command": "-workbench.view.explorer",
        "when": "viewContainer.workbench.view.explorer.enabled"
    },
    {
        "key": "ctrl+shift+8",
        "command": "workbench.action.splitEditor"
    },
    {
        "key": "ctrl+\\",
        "command": "-workbench.action.splitEditor"
    },
    {
        "key": "ctrl+\\",
        "command": "workbench.action.toggleSidebarVisibility"
    },
    {
        "key": "ctrl+b",
        "command": "-workbench.action.toggleSidebarVisibility"
    },
    {
        "key": "ctrl+shift+\\",
        "command": "workbench.action.toggleAuxiliaryBar"
    },
    {
        "key": "ctrl+alt+b",
        "command": "-workbench.action.toggleAuxiliaryBar"
    },
    {
        "key": "alt+space",
        "command": "workbench.action.showCommands"
    },
    {
        "key": "ctrl+shift+p",
        "command": "-workbench.action.showCommands"
    },
    {
        "key": "ctrl+alt+space",
        "command": "workbench.action.quickOpen"
    },
    {
        "key": "ctrl+p",
        "command": "-workbench.action.quickOpen"
    },
    {
        "key": "ctrl+alt+space",
        "command": "-toggleSuggestionFocus",
        "when": "suggestWidgetVisible && textInputFocus"
    },
    {
        "key": "ctrl+alt+space",
        "command": "-workbench.action.terminal.suggestToggleDetailsFocus",
        "when": "!textInputFocus"
    },
    {
        "key": "ctrl+tab",
        "command": "workbench.action.nextEditor"
    },
    {
        "key": "ctrl+pagedown",
        "command": "-workbench.action.nextEditor"
    },
    {
        "key": "ctrl+shift+tab",
        "command": "workbench.action.previousEditor"
    },
    {
        "key": "ctrl+pageup",
        "command": "-workbench.action.previousEditor"
    },
    {
        "key": "ctrl+tab",
        "command": "-workbench.action.quickOpenPreviousRecentlyUsedEditorInGroup",
        "when": "!activeEditorGroupEmpty"
    },
    {
        "key": "ctrl+shift+tab",
        "command": "-workbench.action.quickOpenLeastRecentlyUsedEditorInGroup",
        "when": "!activeEditorGroupEmpty"
    },
    {
        "key": "f5",
        "command": "workbench.action.debug.start",
        "args": {
            "config": "Python: Debug current file (external)"
        },
        "when": "editorLangId == python"
    },
    {
        "key": "ctrl+f5",
        "command": "workbench.action.debug.start",
        "args": {
            "config": "Python: Run current file (external, no debug)"
        },
        "when": "editorLangId == python"
    },
    {
        "key": "f5",
        "command": "workbench.action.debug.start",
        "args": {
            "config": "C: Build & Debug (external)"
        },
        "when": "editorLangId == c || editorLangId == cpp"
    },
    {
        "key": "ctrl+f5",
        "command": "workbench.action.debug.start",
        "args": {
            "config": "C: Build & Run (external, no debug)"
        },
        "when": "editorLangId == c || editorLangId == cpp"
    },
    {
        "key": "f5",
        "command": "workbench.action.debug.start",
        "when": "(debuggersAvailable && debugState == 'inactive') && (editorLangId == 'c' || editorLangId == 'cpp' || editorLangId == 'python') "
    },
    {
        "key": "f5",
        "command": "-workbench.action.debug.start",
        "when": "debuggersAvailable && debugState == 'inactive'"
    },
    {
        "key": "ctrl+f5",
        "command": "workbench.action.debug.run",
        "when": "  (debuggersAvailable && debugState != 'initializing') && (editorLangId != 'c' || editorLangId != 'cpp' || editorLangId != 'python') "
    },
    {
        "key": "ctrl+f5",
        "command": "-workbench.action.debug.run",
        "when": "debuggersAvailable && debugState != 'initializing'"
    },
    {
        "key": "ctrl+k z",
        "command": "workbench.action.toggleZenMode",
        "when": "!isAuxiliaryWindowFocusedContext"
    },
    {
        "key": "ctrl+k z",
        "command": "-workbench.action.toggleZenMode",
        "when": "!isAuxiliaryWindowFocusedContext"
    },
    {
        "key": "ctrl+q",
        "command": "-workbench.action.quit"
    }

]