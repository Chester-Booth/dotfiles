"hyprland/workspaces#main": {
    "output": "eDP-1",
    "active-only": false,
    "all-outputs": false,
    "format": "{icon}",
    "format-icons": {
        "urgent": "󰗖",
        "active": "",
        "default": "󰻃",
        "empty": "󰄰"
        


    },
    "persistent-workspaces": {
        "eDP-1": [1, 2, 3, 4, 5]
    },
    "ignore-workspaces": ["^monitor_(?:[1-9]|10)$"]
  },
  "hyprland/workspaces#dp": {
    "output": "DP-1",
    "active-only": false,
    "all-outputs": false,
    "format": "{icon}",
    "format-icons": {
        "urgent": "󰗖",
        "active": "",
        "default": "󰻃",
        "empty": "󰄰"
      
    },
    "persistent-workspaces": {
        "DP-1": ["monitor_1","monitor_2","monitor_3","monitor_4","monitor_5"]
    },
    "ignore-workspaces": ["^(?:[1-9]|10)$"]
  },
  "hyprland/workspaces#HDMI": {
    "output": "HDMI-A-1",
    "active-only": false,
    "all-outputs": false,
    "format": "{icon}",
    "format-icons": {
        "urgent": "󰗖",
        "active": "",
        "default": "󰻃",
        "empty": "󰄰"
      
    },
    "persistent-workspaces": {
        "HDMI-A-1": ["monitor_6","monitor_7","monitor_8","monitor_9","monitor_10"]
    },
    "ignore-workspaces": ["^(?:[1-9]|10)$"]
  },
  "hyprland/workspaces#special": {
    "output": "eDP-1",
    "show-special": true,
    "format": "{icon}",
    "format-icons": {
        "urgent": "󰘾",
        "active":"󰘻",
        "default": "󰘼",
        "empty": ""
    },
    "persistent-workspaces": {
    },
    "ignore-workspaces": [
        "^(?!.*special).*$"
    ]
    },
    
