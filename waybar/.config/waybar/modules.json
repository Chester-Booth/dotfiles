"clock": {
  "interval": 1,
  "format": "{:%I\n%M\n%S}",
  "format-alt": "<span color='#CDD6F4'>{:%d\n%m\n%y}</span>",
  "tooltip-format": "<tt><small>{calendar}</small></tt>",
  "calendar": {
    "weeks-pos": "left",
    "format": {
       "today": "<span color='#fAfBfC'><b><i>{}</i></b></span>",
       "weekdays": "<b>{}</b>",
       "weeks": "<span color='#9096ab'>{}</span>"
    }
  },
    "rewrite": {
      "Mon": "Mo",
      "Tue": "Tu",
      "Wed": "We",
      "Thu": "Th",
      "Fri": "Fr",
      "Sat": "Sa",
      "Sun": "Su"
  }
},
"custom/menu": {
  "format": "<span size='16pt'>󰅃</span>",
  "tooltip": false
},
"tray": {
  "spacing": 16,
  "reverse-direction": true,
  "icon-size": 16,
  "show-passive-items": true
},
"privacy": {
  "icon-size": 14,
  "transition-duration": 250,
  "modules": [
    {
      "type": "screenshare",
      "tooltip": false,
    }
  ],
  "ignore": [
    {
      "type": "screenshare",
      "name": "obs"
    }
  ]
},
"network": {
  "format-icons": {
    "wifi": [
      "<span size='12pt'>󰤯</span>",
      "<span size='12pt'>󰤟</span>",
      "<span size='12pt'>󰤢</span>",
      "<span size='12pt'>󰤥</span>",
      "<span size='12pt'>󰤨</span>"
    ],
    "ethernet": "<span size='12pt'>󰈀</span>",
    "disabled": "<span size='12pt'>󰤭</span>",
    "disconnected": "<span size='12pt'>󰤩</span>"
  },
  "format-wifi": "{icon}",
  "format-ethernet": "{icon}",
  "format-disconnected": "{icon}",
  "format-disabled": "{icon}",
  "tooltip-format": "{essid}\n{gwaddr}\n{bandwidthUpBits}   {signalStrength}\n{bandwidthDownBits}   {frequency}GHz",
  "on-click": "~/.config/waybar/scripts/network/nm-applet-toggle.sh",
  "tooltip": true,
  "max-length": 20,
  "interval": 5

},
"bluetooth": {
  "interval": 5,
  "format-on": "<span size='14pt'>󰂯</span>",
  "format-off": "<span size='14pt'>󰂲</span>",
  "format-disabled": "<span size='14pt'>󰂲</span>",
  "format-connected": "<span size='14pt'>󰂱</span>",
  "format-no-controller": "span size='14pt'>󰂯</span>",
  "tooltip": true,
  "tooltip-format": "{device_enumerate}",
  "tooltip-format-enumerate-connected": "{device_address}",
  "tooltip-format-enumerate-connected-battery": "{device_address} | Battery: {device_battery_percentage}%",
  "on-click": "rfkill toggle bluetooth",
  "on-click-right": "blueman-manager"
},
"pulseaudio#microphone": {
  "format": "{format_source}",
  "format-source": "<span size='14pt'>󰍬</span>",
  "format-source-muted": "<span size='14pt'>󰍭</span>",
  "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
  "on-click-right": "pavucontrol -t 4",
  "tooltip": false
},
"backlight/slider": {
    "min": 0, 
    "orientation": "vertical",
    "device": "amdgpu_bl1"
},
"backlight": {
    "device": "amdgpu_bl1",
    "format": "{icon}",
    "format-icons": ["󰃚", "󰃛", "󰃜", "󰃝", "󰃞", "󰃟", "󰃠"],
    "tooltip": false,
    // Keep these commands ONLY on the icon module
    "on-scroll-up": "brightnessctl -d amdgpu_bl1 set +2%",
    "on-scroll-down": "brightnessctl -d amdgpu_bl1 set 2%-"
},
"pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "vertical"},
"pulseaudio": {
    "format": "{icon}",
    "format-icons": [
        "<span size='14pt'>󰕿</span>",
        "<span size='14pt'>󰖀</span>",
        "<span size='14pt'>󰕾</span>"
    ],
    "format-muted": "<span size='14pt'>󰝟</span>",
    "on-click-right": "pavucontrol -t 3",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%\n{desc}",
    "ignored-sinks": ["Easy Effects Sink"]
},

"battery": {
  "interval": 5,
  "states": {
    "critical": 10
  },

  "format": "{icon}\n<span size='9pt'>{capacity}</span>",
  "format-alt": "{icon}",
  "justify": "center",  
  "align": 0.5,    
       
  "format-icons": {
    "charging": "<span size='14pt'>󰂄</span>",
    "plugged": "<span size='14pt'>󰚥</span>",
    "critical": "<span size='14pt'>󰂃</span>",
    "default": [
        "<span size='14pt'>󰁺</span>",
        "<span size='14pt'>󰁻</span>",
        "<span size='14pt'>󰁼</span>",
        "<span size='14pt'>󰁽</span>",
        "<span size='14pt'>󰁾</span>",
        "<span size='14pt'>󰁿</span>",
        "<span size='14pt'>󰂀</span>",
        "<span size='14pt'>󰂁</span>",
        "<span size='14pt'>󰂂</span>",
        "<span size='14pt'>󰁹</span>"
    ]
  },

  
  "tooltip": true,
  "tooltip-format": "Charge: {capacity}%\n{time}"
},
"custom/gpu": {
        "format": "{icon}",
        "format-icons": {
            "gaming": "󰪫",
            "performance": "󰢮",
            "high-refresh": "",
            "eco": "󰌪"
        },
        "exec": "~/.config/waybar/scripts/gpu/gpu-status.sh",
        "interval": 5,
        "return-type": "json",
        "menu": "on-click",
        "menu-file": "~/.config/waybar/scripts/gpu/gpu_menu.xml",
        "menu-actions": {
            "gaming-mode": "~/.config/waybar/scripts/gpu/modes/gpu144.sh",
            "perf-mode": "~/.config/waybar/scripts/gpu/modes/gpu60.sh",
            "high-refresh": "~/.config/waybar/scripts/gpu/modes/igpu144.sh",
            "eco-mode": "~/.config/waybar/scripts/gpu/modes/igpu60.sh",
            "nvidia-settings": "~/.config/waybar/scripts/gpu/launch-nvidia-settings.sh",                        
            "toggle-gpu": "~/.config/waybar/scripts/gpu/gpu-toggle.sh"
        } 
},
"custom/fan": {
        "format": "{icon}",
        "format-icons": {
            "Performance": "󱑬",
            "Balanced": "󱜝",
            "Quiet": "󰠝"
        },
        "exec": "~/.config/waybar/scripts/fan/fan-status.sh",
        "interval": 10,
        "return-type": "json",
        "menu": "on-click",
        "menu-file": "~/.config/waybar/scripts/fan/fan_menu.xml",
        "menu-actions": {
            "Performance": "asusctl profile set performance; notify-send -u low '󱑬  Performance Mode Activated'",
            "Balanced": "asusctl profile set balanced; notify-send -u low '󱜝 Balanced Mode Activated'",
            "Quiet": "asusctl profile set quiet; notify-send -u low '󰠝 Quiet Mode Activated'"
        } 
},
"custom/todo": {
  "exec": "~/.config/waybar/scripts/todo/todo.sh",
  "interval": 10,
  "return-type": "json",
  "format": "{text}",
  "on-click-right": "~/.config/waybar/scripts/todo/open.sh",
  "on-click": "~/.config/waybar/scripts/todo/cycle.sh",
  "tooltip": true
},
"custom/cal": {
    "exec": "~/.config/waybar/scripts/cal/cal.sh",
    "interval": 10,
    "return-type": "json",
    "format": "{text}",
    "on-click": "~/.config/waybar/scripts/cal/add.sh",
    "on-click-right": "~/.config/waybar/scripts/cal/cycle.sh",
    "tooltip3": true
},
"custom/update": {
    "exec": "~/.config/waybar/scripts/update/update.sh",
    "interval": 3600,
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "zero": "󰅠",
      "lessfifty": "󰅢",
      "fifty": "󰧠",
      "hundred": "󰧠"
    },
    "tooltip": true,
    "on-click": "kitty --class update --title update sh -c '~/.config/waybar/scripts/update/update-run.sh; echo Done - press enter; read'; pkill -SIGRTMIN+8 waybar",
    "on-click-right": "kitty --class update-list --title update-list sh -c '~/.config/waybar/scripts/update/update-list.sh'",
    "signal": 8
},
"custom/notification": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
},
"custom/power": {
    "format" : "⏻",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/scripts/power/power_menu.xml",
        "menu-actions": {
            "lock": "hyprlock", 
            "sleep": "systemctl suspend-then-hibernate",
            "shutdown": "systemctl poweroff",
            "reboot": "systemctl reboot",
            "hibernate": "systemctl hibernate"
        }
},
"custom/workspaces": {
    "exec": "~/.config/waybar/scripts/custom_workspace_script.py",
    "return-type": "json",
    "interval": 1,
    "format": "{}",
    "on-click": "hyprctl dispatch workspace {id}",
    "tooltip": true
  }

}




